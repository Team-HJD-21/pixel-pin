<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets/app.ico</ApplicationIcon>
    <AssemblyName>PixelPin</AssemblyName>
    <Product>Pixel Pin</Product>
    <Title>Pixel Pin</Title>
    <Authors>TeamHJD</Authors>
    <Description>A small Windows pixel color picker. Pick, pin, and copy HEX colors.</Description>
    <Copyright>Copyright © 2026 TeamHJD. All rights reserved.</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup><Resource Include="assets/app.ico"/><Resource Include="assets/app-icon.png"/></ItemGroup>
</Project>
